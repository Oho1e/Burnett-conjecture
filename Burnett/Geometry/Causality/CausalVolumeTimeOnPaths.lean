variable {M : Type*} [TopologicalSpace M] [ChartedSpace CoordinateSpace M] [IsManifold Model ∞ M]

/-- The compact-diamond and strong-causality conditions for the intrinsic
future causal relation generated by the actual Lorentzian chart segments. -/
structure ChartGlobalHyperbolicity {g : Field (M := M)} (o : TimeOrientation g) : Prop where
  noTimelikeLoop : ∀ p, (p, p) ∉ chartChronology o
  compactDiamonds : ∀ a b : M, IsCompact {z : M |
    (a, z) ∈ chartCausalRelation o ∧ (z, b) ∈ chartCausalRelation o}
  causalConvexNeighborhoods : ∀ x : M, ∀ U ∈ 𝓝 x, ∃ V ∈ 𝓝 x, V ⊆ U ∧
    ∀ ⦃a z b : M⦄, a ∈ V → b ∈ V → (a, z) ∈ chartCausalRelation o →
      (z, b) ∈ chartCausalRelation o → z ∈ V

private theorem surjOn_of_two_tail_directions {I : Set ℝ} (u : ℝ → ℝ)
    (hI : I.OrdConnected) (hu : ContinuousOn u I)
    {ℱ 𝒢 : Filter I} [NeBot ℱ] [NeBot 𝒢]
    (hlo : Tendsto (fun t : I => u t) ℱ atBot) (hhi : Tendsto (fun t : I => u t) 𝒢 atTop) :
    SurjOn u I univ := by
  intro r _
  obtain ⟨a, ha⟩ := (tendsto_atBot.mp hlo r).exists
  obtain ⟨b, hb⟩ := (tendsto_atTop.mp hhi r).exists
  have hConn := isPreconnected_iff_ordConnected.mpr hI
  have hmem : r ∈ u '' I := hConn.intermediate_value a.property b.property hu ⟨ha, hb⟩
  exact hmem

variable [T2Space M] [SecondCountableTopology M] [MeasurableSpace M] [BorelSpace M]

/-- The very same continuous volume time takes every real value along every
regular causal path that has neither a past nor a future limit. -/
theorem exists_continuous_completeCausalVolumeTime {g : Field (M := M)} (hg : IsSmooth g)
    (hL : HasLorentzSignature g) (o : TimeOrientation g) (hGH : ChartGlobalHyperbolicity o) :
    ∃ T : M → ℝ, Continuous T ∧
      ∀ (γ : ℝ → M) (I : Set ℝ), IsOpen I → I.OrdConnected →
        ∀ [Nonempty I] [IsCountablyGenerated (atTop : Filter I)] [IsCountablyGenerated (atBot : Filter I)],
        ContMDiffOn 𝓘(ℝ) Model 1 γ I → RegularCausalOn g γ I →
        (∀ x : M, ¬ Tendsto (fun t : I => γ t) atBot (𝓝 x)) →
        (∀ x : M, ¬ Tendsto (fun t : I => γ t) atTop (𝓝 x)) →
        (MonotoneOn (T ∘ γ) I ∨ AntitoneOn (T ∘ γ) I) ∧ SurjOn (T ∘ γ) I univ := by
  obtain ⟨μ, hFin, hPos, _, _, hTc, hStrict⟩ := exists_continuous_strict_chartCausal_time hg hL o
    hGH.noTimelikeLoop hGH.compactDiamonds hGH.causalConvexNeighborhoods
  letI := hFin
  letI := hPos
  let T p := Real.log (μ (sectionAt (chartChronology o) p)).toReal -
    Real.log (μ (sectionAt (Prod.swap ⁻¹' chartChronology o) p)).toReal
  refine ⟨T, hTc, ?_⟩
  intro γ I hI hOrd hNe hCountR hCountL hγ hReg hNoPast hNoFuture
  have hIne : I.Nonempty := by
    obtain ⟨a⟩ := hNe
    exact ⟨a.val, a.property⟩
  let β : I → M := fun t => γ t
  have hC : ContinuousOn (T ∘ γ) I := hTc.comp_continuousOn hγ.continuousOn
  have hLe {a b : M} (h : (a, b) ∈ chartCausalRelation o) : T a ≤ T b := by
    by_cases he : a = b
    · rw [he]
    · exact (hStrict h he).le
  rcases chartCausalRelation_orders_regular_curve hg hL o γ hI hOrd hIne hγ hReg with hF | hP
  · have hRel {a b : I} (hab : a ≤ b) : (β a, β b) ∈ chartCausalRelation o :=
      hF a.property b.property hab
    obtain ⟨hLo, hHi⟩ := causal_path_logVolume_diverges hg hL o μ hGH.compactDiamonds
      hGH.causalConvexNeighborhoods β (fun h => hRel h) hNoPast hNoFuture
    exact ⟨Or.inl (fun _ ha _ hb hab => hLe (hF ha hb hab)),
      surjOn_of_two_tail_directions (T ∘ γ) hOrd hC hLo hHi⟩
  · let βrev : Iᵒᵈ → M := β
    have hRel {a b : Iᵒᵈ} (hab : a ≤ b) : (βrev a, βrev b) ∈ chartCausalRelation o :=
      hP (OrderDual.ofDual b).property (OrderDual.ofDual a).property hab
    obtain ⟨hLo, hHi⟩ := causal_path_logVolume_diverges hg hL o μ hGH.compactDiamonds
      hGH.causalConvexNeighborhoods βrev (fun h => hRel h) hNoFuture hNoPast
    exact ⟨Or.inr (fun _ ha _ hb hab => hLe (hP ha hb hab)),
      surjOn_of_two_tail_directions (T ∘ γ) hOrd hC (ℱ := atTop) (𝒢 := atBot) hLo hHi⟩

end Burnett.Geometry.FiniteCausalVolume
