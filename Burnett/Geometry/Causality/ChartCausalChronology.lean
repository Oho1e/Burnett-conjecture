import Burnett.Geometry.Causality.CausalTimeDirectionChange
import Burnett.Geometry.Causality.IntrinsicChronologicalCurves
import Burnett.Geometry.Causality.ChartChronologicalNeighborhoods

set_option autoImplicit false
set_option maxHeartbeats 5500000

noncomputable section

namespace Burnett.Geometry.FiniteCausalVolume

open Set Filter Bundle
open scoped ContDiff Manifold Topology
open Burnett.Geometry.ConnectionDifference Burnett.Geometry.ManifoldMetric
open Burnett.Geometry.ManifoldBilinear Burnett.Geometry.ManifoldMetricTransition

local notation "E" => CoordinateSpace

variable {M : Type*} [TopologicalSpace M] [ChartedSpace E M] [IsManifold Model ∞ M]

theorem chart_causal_sign_change {g : Field (M := M)} (hL : HasLorentzSignature g)
    (c : M) {y n w v : E} (hy : y ∈ (chartAt E c).target)
    (hn : coordinateBilinear g c y n n < 0) (hw : coordinateBilinear g c y w w < 0)
    (hnw : coordinateBilinear g c y n w < 0) (hv : v ≠ 0)
    (hvv : coordinateBilinear g c y v v ≤ 0) (hnv : coordinateBilinear g c y n v < 0) :
    coordinateBilinear g c y w v < 0 := by
  let x := (chartAt E c).symm y
  have hx : x ∈ (chartAt E c).source := (chartAt E c).symm_mapsTo hy
  let e := (trivializationAt E (TangentSpace Model) c).continuousLinearEquivAt ℝ x hx
  obtain ⟨b, hb⟩ := hL x
  let B := coordinateBilinear g c y
  have hBasis (i j : Burnett.RicciSymbol.Index) :
      B ((b.map e.toLinearEquiv) i) ((b.map e.toLinearEquiv) j) = Burnett.RicciSymbol.TensorFrame.standardInverse i j := by
    change g x (e.symm ((b.map e.toLinearEquiv) i)) (e.symm ((b.map e.toLinearEquiv) j)) = _
    rw [Module.Basis.map_apply, Module.Basis.map_apply]
    change g x (e.symm (e (b i))) (e.symm (e (b j))) = _
    rw [e.symm_apply_apply, e.symm_apply_apply]
    exact hb i j
  exact causal_sign_preserved_between_timelike_directions B
    (coordinateBilinear_symmetric g hL.isSymmetric c y) (b.map e.toLinearEquiv) hBasis n w v hn hw hnw hv hvv hnv

/-- A curve confined to an actual chart with future timelike derivative has
endpoints in the intrinsic chronology generated by oriented chart chords. -/
theorem chartChronology_of_future_coordinate_curve {g : Field (M := M)} (hg : IsSmooth g)
    (o : TimeOrientation g) (c : M) (y v : ℝ → E) {a b : ℝ} (hab : a < b)
    (hY : ∀ t ∈ Icc a b, HasDerivAt y (v t) t ∧ (y t, v t) ∈ futureChartVelocities o c) :
    (((chartAt E c).symm (y a)), ((chartAt E c).symm (y b))) ∈ chartChronology o := by
  let e := chartAt E c
  let γ := e.symm ∘ y
  let J := fun x z : M => (x, z) ∈ chartChronology o
  have hTrans : Transitive J := fun _ _ _ h₁ h₂ => Relation.TransGen.trans h₁ h₂
  apply interval_relation_of_local_steps hTrans γ hab
  intro t ht
  obtain ⟨hd, hv⟩ := hY t ht
  have hNear : ∀ᶠ s in 𝓝 t, y s ∈ e.target :=
    hd.continuousAt.preimage_mem_nhds (e.open_target.mem_nhds hv.1)
  filter_upwards [hNear.filter_mono nhdsWithin_le_nhds,
    eventually_future_chords_of_chart_derivative hg o c y t (v t) hd hv] with s hs hsec
  constructor
  · intro hts
    apply Relation.TransGen.single
    refine ⟨c, e.symm_mapsTo hv.1, e.symm_mapsTo hs, ?_⟩
    change (e (e.symm (y t)), e (e.symm (y s))) ∈ futureCoordinateChords o c
    rw [e.right_inv hv.1, e.right_inv hs]
    exact hsec.1 hts
  · intro hst
    apply Relation.TransGen.single
    refine ⟨c, e.symm_mapsTo hs, e.symm_mapsTo hv.1, ?_⟩
    change (e (e.symm (y s)), e (e.symm (y t))) ∈ futureCoordinateChords o c
    rw [e.right_inv hs, e.right_inv hv.1]
    exact hsec.2 hst

/-- The chronological past of the initial point of a causal chart segment
is contained in that of the final point. The strict timelike approximation
uses a perturbation that keeps the final point unchanged. -/
theorem chartCausalWindow_past_subset {g : Field (M := M)} (hg : IsSmooth g) (hL : HasLorentzSignature g)
    (o : TimeOrientation g) (c : M) (x n : E) {r R a b V : ℝ} (hab : a < b) (hRad : r < R)
    (hTarget : Metric.closedBall x R ⊆ (chartAt E c).target)
    (hn : ∀ z ∈ Metric.closedBall x R, coordinateBilinear g c z n n < 0)
    (hnT : ∀ z ∈ Metric.closedBall x R,
      coordinateBilinear g c z n (ChartVectorField.coordinateVector o.vector c z) < 0)
    (y v : ℝ → E) (hV : 0 ≤ V)
    (hpath : ∀ t ∈ Icc a b, y t ∈ Metric.closedBall x r ∧ HasDerivAt y (v t) t ∧
      coordinateBilinear g c (y t) (v t) (v t) ≤ 0 ∧
      coordinateBilinear g c (y t) n (v t) ≤ 0 ∧ ‖v t‖ ≤ V) :
    sectionAt (chartChronology o) ((chartAt E c).symm (y a)) ⊆
      sectionAt (chartChronology o) ((chartAt E c).symm (y b)) := by
  let e := chartAt E c
  let K := Metric.closedBall x R
  obtain ⟨k, _, e₀, he₀, hPush⟩ := chartCausalCurve_time_push hg hL c x n hRad hTarget hn y v hV hpath
  intro q hq
  let W := (fun p : M => (q, p)) ⁻¹' chartChronology o
  have hW : IsOpen W := (isOpen_chartChronology hg o).preimage (continuous_const.prodMk continuous_id)
  have haya : y a ∈ e.target := hTarget ((Metric.closedBall_subset_closedBall hRad.le)
    (hpath a (left_mem_Icc.mpr hab.le)).1)
  let F (ε : ℝ) := y a + (ε * endpointTimePush k b a) • n
  have hF : Continuous F := by dsimp only [F]; fun_prop
  have hF0 : F 0 = y a := by simp [F]
  have hAt : ContinuousAt (e.symm ∘ F) 0 := (e.symm.continuousAt (hF0.symm ▸ haya)).comp hF.continuousAt
  have hWnear : (e.symm ∘ F) ⁻¹' W ∈ 𝓝 (0 : ℝ) := hAt.preimage_mem_nhds
    (hW.mem_nhds (show e.symm (F 0) ∈ W by rwa [hF0]))
  obtain ⟨ρ, hρ, hBall⟩ := Metric.mem_nhds_iff.mp hWnear
  let ε := min ρ e₀ / 2
  have hε : 0 < ε := half_pos (lt_min hρ he₀)
  have hεall : ε < min ρ e₀ := half_lt_self (lt_min hρ he₀)
  have hεball : ε ∈ Metric.ball 0 ρ := by
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_pos hε]
    exact hεall.trans_le (min_le_left _ _)
  let z t := y t + (ε * endpointTimePush k b t) • n
  obtain ⟨hzb, hShift⟩ := hPush ε hε (hεall.trans_le (min_le_right _ _))
  let w t := v t + (ε * (k * Real.exp (k * (b - t)))) • n
  have hTimelike (t : ℝ) (ht : t ∈ Icc a b) : HasDerivAt z (w t) t ∧ (z t, w t) ∈ futureChartVelocities o c := by
    obtain ⟨hz, hd, hv, hm⟩ := hShift t ht
    let T := ChartVectorField.coordinateVector o.vector c (z t)
    have ht' := hTarget hz
    have hT : coordinateBilinear g c (z t) T T < 0 := by
      change g (e.symm (z t)) (tangentFrame c (e.symm (z t)) T) (tangentFrame c (e.symm (z t)) T) < 0
      rw [ChartVectorField.tangentFrame_coordinateVector o.vector c ht']
      exact o.timelike _
    have hw : w t ≠ 0 := by
      intro h
      change coordinateBilinear g c (z t) n (w t) < 0 at hm
      rw [h, map_zero] at hm
      exact (lt_irrefl _ hm).elim
    exact ⟨hd, ht', hv, chart_causal_sign_change hL c ht' (hn (z t) hz) hT (hnT (z t) hz) hw hv.le hm⟩
  have hRel : (e.symm (z a), e.symm (z b)) ∈ chartChronology o :=
    chartChronology_of_future_coordinate_curve hg o c z w hab hTimelike
  have hqz : (q, e.symm (z a)) ∈ chartChronology o := hBall hεball
  rw [← hzb]
  exact Relation.TransGen.trans hqz hRel

end Burnett.Geometry.FiniteCausalVolume
