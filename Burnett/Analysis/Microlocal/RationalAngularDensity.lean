import Burnett.Analysis.Microlocal.RationalAngularSymbols
import Mathlib.Topology.ContinuousMap.StoneWeierstrass
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.Topology.Instances.Rat

set_option autoImplicit false

noncomputable section

namespace Burnett.Microlocal.SmoothAngularTests

open Burnett.Microlocal.AngularCommutator MvPolynomial
open scoped ContDiff

instance instCompactUnitSphere : CompactSpace UnitSphere :=
  isCompact_iff_compactSpace.mp (isCompact_sphere _ _)

private theorem unitSphere_subset_nonzero :
    Metric.sphere (0 : Space) 1 ⊆ ({0}ᶜ : Set Space) := by
  intro ξ hξ
  have hn : ‖ξ‖ = 1 := by simpa only [Metric.mem_sphere, dist_zero_right] using hξ
  exact norm_ne_zero_iff.mp (hn.symm ▸ one_ne_zero)

/-- The continuous restriction of an actual normalized coordinate to the sphere. -/
def sphereCoordinate (i : Fin 4) : C(UnitSphere, ℝ) where
  toFun x := angularCoordinate i x
  continuous_toFun :=
    ((angularCoordinate_contDiffOn i).continuousOn.mono unitSphere_subset_nonzero).restrict

theorem sphereCoordinate_apply (i : Fin 4) (x : UnitSphere) :
    sphereCoordinate i x = (x : Space) i := by
  have hn : ‖(x : Space)‖ = 1 := by
    simpa only [Metric.mem_sphere, dist_zero_right] using x.property
  change (x : Space) i / ‖(x : Space)‖ = _
  rw [hn, div_one]

theorem sphereCoordinate_separates (x y : UnitSphere) (hxy : x ≠ y) :
    ∃ i, sphereCoordinate i x ≠ sphereCoordinate i y := by
  by_contra! h
  exact hxy (Subtype.ext (PiLp.ext fun i => by simpa only [sphereCoordinate_apply] using h i))

/-- The real unital subalgebra generated by the actual normalized coordinates. -/
def realSphereAlgebra : Subalgebra ℝ C(UnitSphere, ℝ) :=
  Algebra.adjoin ℝ (Set.range sphereCoordinate)

theorem realSphereAlgebra_separates : realSphereAlgebra.SeparatesPoints := by
  intro x y hxy
  obtain ⟨i, hi⟩ := sphereCoordinate_separates x y hxy
  have hmem : sphereCoordinate i ∈ realSphereAlgebra :=
    Algebra.subset_adjoin (Set.mem_range_self i)
  exact ⟨_, ⟨sphereCoordinate i, hmem, rfl⟩, hi⟩

theorem realSphereAlgebra_dense : realSphereAlgebra.topologicalClosure = ⊤ :=
  ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints _
    realSphereAlgebra_separates

/-- Rational polynomials evaluated on the sphere as a ring homomorphism. -/
def rationalSphereEval : RationalPolynomial →+* C(UnitSphere, ℝ) :=
  MvPolynomial.eval₂Hom (algebraMap ℚ C(UnitSphere, ℝ)) sphereCoordinate

theorem rationalSphereEval_apply (p : RationalPolynomial) (x : UnitSphere) :
    rationalSphereEval p x = rationalAngular p x := by
  change (ContinuousMap.evalAlgHom ℚ ℝ x).toRingHom
    (p.eval₂ (algebraMap ℚ C(UnitSphere, ℝ)) sphereCoordinate) = _
  rw [MvPolynomial.eval₂_comp_left]
  rfl

private def rationalSphereClosure : Subalgebra ℝ C(UnitSphere, ℝ) where
  __ := rationalSphereEval.range.topologicalClosure.toSubsemiring
  algebraMap_mem' := by
    intro r
    change ContinuousMap.const UnitSphere r ∈ closure (Set.range rationalSphereEval)
    have hr : r ∈ closure (Set.range fun q : ℚ => (q : ℝ)) := Rat.denseRange_cast r
    have hmap := image_closure_subset_closure_image (f := ContinuousMap.const UnitSphere)
      (s := Set.range fun q : ℚ => (q : ℝ)) ContinuousMap.continuous_const'
    refine closure_mono ?_ (hmap ⟨r, hr, rfl⟩)
    rintro _ ⟨_, ⟨q, rfl⟩, rfl⟩
    refine ⟨MvPolynomial.C q, ?_⟩
    change MvPolynomial.eval₂ _ _ (MvPolynomial.C q) = _
    rw [MvPolynomial.eval₂_C]
    rfl

theorem rationalSphereEval_dense : DenseRange rationalSphereEval := by
  have hle : realSphereAlgebra ≤ rationalSphereClosure := by
    apply Algebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    change sphereCoordinate i ∈ closure (Set.range rationalSphereEval)
    apply subset_closure
    refine ⟨MvPolynomial.X i, ?_⟩
    exact MvPolynomial.eval₂_X _ _ _
  have hclosed : IsClosed (rationalSphereClosure : Set C(UnitSphere, ℝ)) := isClosed_closure
  have htop := Subalgebra.topologicalClosure_minimal hle hclosed
  rw [realSphereAlgebra_dense] at htop
  intro f
  exact htop (show f ∈ (⊤ : Subalgebra ℝ C(UnitSphere, ℝ)) from trivial)

private def combineComplex
    (f : C(UnitSphere, ℝ) × C(UnitSphere, ℝ)) : C(UnitSphere, ℂ) :=
  (⟨Complex.ofReal, Complex.ofRealCLM.continuous⟩ : C(ℝ, ℂ)).comp f.1 +
    ContinuousMap.const UnitSphere Complex.I *
      (⟨Complex.ofReal, Complex.ofRealCLM.continuous⟩ : C(ℝ, ℂ)).comp f.2

private theorem continuous_combineComplex : Continuous combineComplex := by
  exact ((ContinuousMap.continuous_postcomp _).comp continuous_fst).add
    (continuous_const.mul ((ContinuousMap.continuous_postcomp _).comp continuous_snd))

/-- Continuous restriction of the same complex symbol used by the multiplier. -/
def complexRationalSphere
    (p : RationalPolynomial × RationalPolynomial) : C(UnitSphere, ℂ) :=
  combineComplex (rationalSphereEval p.1, rationalSphereEval p.2)

theorem complexRationalSphere_apply (p : RationalPolynomial × RationalPolynomial) (x : UnitSphere) :
    complexRationalSphere p x = complexRationalAngularSymbol p x := by
  change (rationalSphereEval p.1 x : ℂ) + Complex.I * (rationalSphereEval p.2 x : ℂ) = _
  rw [rationalSphereEval_apply, rationalSphereEval_apply]
  rfl

theorem complexRationalSphere_dense : DenseRange complexRationalSphere := by
  intro f
  let g : C(UnitSphere, ℝ) × C(UnitSphere, ℝ) :=
    ((⟨Complex.re, Complex.reCLM.continuous⟩ : C(ℂ, ℝ)).comp f,
      (⟨Complex.im, Complex.imCLM.continuous⟩ : C(ℂ, ℝ)).comp f)
  let S := Set.range rationalSphereEval
  have hg : g ∈ closure (S ×ˢ S) := by
    rw [closure_prod_eq]
    exact ⟨rationalSphereEval_dense g.1, rationalSphereEval_dense g.2⟩
  have himage : combineComplex g ∈ closure (combineComplex '' (S ×ˢ S)) :=
    image_closure_subset_closure_image continuous_combineComplex ⟨g, hg, rfl⟩
  have hsub : combineComplex '' (S ×ˢ S) ⊆ Set.range complexRationalSphere := by
    rintro _ ⟨⟨u, v⟩, ⟨⟨p, rfl⟩, ⟨q, rfl⟩⟩, rfl⟩
    exact ⟨(p, q), rfl⟩
  have hgf : combineComplex g = f := by
    ext x
    change ((f x).re : ℂ) + Complex.I * ((f x).im : ℂ) = f x
    rw [mul_comm]
    exact Complex.re_add_im _
  simpa only [hgf] using closure_mono hsub himage

/-- A single countable sequence of actual symbols has dense sphere restrictions. -/
theorem exists_dense_rationalAngular_enumeration :
    ∃ e : ℕ → RationalPolynomial × RationalPolynomial,
      Function.Surjective e ∧ DenseRange (complexRationalSphere ∘ e) := by
  obtain ⟨e, he⟩ := exists_rationalAngular_enumeration
  refine ⟨e, he, ?_⟩
  intro f
  apply closure_mono ?_ (complexRationalSphere_dense f)
  intro y hy
  obtain ⟨p, rfl⟩ := hy
  obtain ⟨n, rfl⟩ := he p
  exact ⟨n, rfl⟩

/-- The continuous restriction of a smooth angular symbol to the unit sphere. -/
def restrictAngular (m : Space → ℂ) (hs : ContDiffOn ℝ ∞ m ({0}ᶜ : Set Space)) :
    C(UnitSphere, ℂ) where
  toFun x := m x
  continuous_toFun := (hs.continuousOn.mono unitSphere_subset_nonzero).restrict

/-- Sphere approximation controls the same actual symbol uniformly at every nonzero frequency. -/
theorem exists_rationalAngular_uniform_on_nonzero
    (m : Space → ℂ) (hs : ContDiffOn ℝ ∞ m ({0}ᶜ : Set Space)) (hd : DegreeZero m)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ p : RationalPolynomial × RationalPolynomial,
      ∀ ξ : Space, ξ ≠ 0 → ‖complexRationalAngularSymbol p ξ - m ξ‖ < ε := by
  obtain ⟨p, hp⟩ := Metric.denseRange_iff.mp complexRationalSphere_dense
    (restrictAngular m hs) ε hε
  have hnorm : ‖complexRationalSphere p - restrictAngular m hs‖ < ε := by
    rw [← dist_eq_norm, dist_comm]
    exact hp
  refine ⟨p, fun ξ hξ => ?_⟩
  have hξn : 0 < ‖ξ‖ := norm_pos_iff.mpr hξ
  let r := ‖ξ‖⁻¹
  have hr : 0 < r := inv_pos.mpr hξn
  let x : UnitSphere := ⟨r • ξ, by
    rw [Metric.mem_sphere, dist_zero_right, norm_smul, Real.norm_eq_abs, abs_of_pos hr]
    exact inv_mul_cancel₀ hξn.ne'⟩
  have hx := ((complexRationalSphere p) - restrictAngular m hs).norm_coe_le_norm x
  have hpoint : ‖complexRationalAngularSymbol p (r • ξ) - m (r • ξ)‖ < ε := by
    simpa only [ContinuousMap.sub_apply, complexRationalSphere_apply] using hx.trans_lt hnorm
  change ‖complexRationalAngular p (r • ξ) - m (r • ξ)‖ < ε at hpoint
  rw [complexRationalAngular_degreeZero p r hr ξ, hd r hr ξ] at hpoint
  exact hpoint

end Burnett.Microlocal.SmoothAngularTests
